# Use 5433 when local Postgres already binds 5432 (docker-compose default)
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio_os
JWT_SECRET=change-me
PORT=4001
AGENT_RUNNER_SECRET=dev-runner-secret
AGENT_RUNNER_URL=http://localhost:3940
PORTFOLIOOS_API_URL=http://localhost:4001
QLIX_ADK_PATH=../qlix-monorepo/adk_new
PORTFOLIO_PYTHON=/opt/homebrew/bin/python3.12

# Qlix inference — one hybrid agent on backend-adk (npm run dev in qlix-monorepo/backend-adk, port 4000).
QLIX_BACKEND_URL=http://localhost:4000
# Per-workspace Qlix: each workspace gets its own Qlix org with an "Assistant" and a
# "Report writer" agent (docs/QLIX_WORKSPACES.md). Get the partner key once from Qlix:
#   curl -X POST $QLIX_BACKEND_URL/api/v1/partners/register -H "x-admin-key: <PARTNER_REGISTRATION_KEY>" \
#        -H 'Content-Type: application/json' -d '{"slug":"orbit","name":"Orbit"}'
QLIX_PARTNER_KEY=
# whsec_… from Qlix: verifies webhooks at POST /qlix/webhook (Qlix calls http://portfolio:4001/qlix/webhook).
QLIX_WEBHOOK_SECRET=
# 32+ random characters; encrypts the Qlix keys Orbit stores. Never change it after setup.
QLIX_SECRETS_KEY=
# Qlix console in the browser (local: http://localhost:3010). Also allowed to frame Orbit.
QLIX_CONSOLE_URL=http://localhost:3010
# Migration only: 1 = workspaces not yet provisioned use the shared QLIX_AGENT_ID below.
QLIX_LEGACY_AGENT_FALLBACK=0
QLIX_AGENT_ID=
QLIX_RUNNER_TOKEN=

# Qlix WhatsApp sidecar (platform/qlix-whatsapp-service) on 3939.
# Its QLIX_URL is this gateway (http://127.0.0.1:3938). SERVICE_SECRET must match WA_SERVICE_SECRET.
WA_PORT=3938
WA_SERVICE_URL=http://127.0.0.1:3939
# UUID v4 — same id every time you link this Portfolio bot (e.g. uuidgen).
WA_CONNECTOR_ID=
WA_SERVICE_SECRET=dev-runner-secret

# Meetings: scripts/dev.sh runs `livekit-server --dev` (key devkey / secret secret) on :7880.
# Leave these empty in development; the API uses the dev key pair outside production.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=
LIVEKIT_URL=
