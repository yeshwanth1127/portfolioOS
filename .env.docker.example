# Copy to .env next to docker-compose.yml (Compose loads it automatically).

JWT_SECRET=change-me-in-production
AGENT_RUNNER_SECRET=dev-runner-secret
WA_SERVICE_SECRET=dev-runner-secret

# Browser → API (host ports)
NEXT_PUBLIC_API_URL=http://localhost:4001

# Qlix backend-adk running on the host (npm run dev in qlix-monorepo/backend-adk)
QLIX_BACKEND_URL=http://host.docker.internal:4000
QLIX_AGENT_ID=
QLIX_RUNNER_TOKEN=

# Optional fixed connector UUID (otherwise generated once into the wa_auth volume)
WA_CONNECTOR_ID=

# 64 hex chars — keep stable across restarts so WhatsApp session persists
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_AUTH_ENCRYPTION_KEY=

# Set to 0 after first boot if you do not want re-seed attempts
SEED_ON_START=1
