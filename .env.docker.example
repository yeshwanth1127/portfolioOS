# Copy to .env next to docker-compose.yml (Compose loads it automatically).

JWT_SECRET=change-me-in-production
AGENT_RUNNER_SECRET=dev-runner-secret
WA_SERVICE_SECRET=dev-runner-secret

# Browser → API (host ports)
NEXT_PUBLIC_API_URL=http://localhost:4001

# Qlix backend-adk running on the host (npm run dev in qlix-monorepo/backend-adk)
QLIX_BACKEND_URL=http://backend:4000
# Per-workspace Qlix: each workspace gets its own Qlix org with an "Assistant" and a
# "Report writer" agent (docs/QLIX_WORKSPACES.md). Get the partner key once from Qlix:
#   curl -X POST $QLIX_BACKEND_URL/api/v1/partners/register -H "x-admin-key: <PARTNER_REGISTRATION_KEY>" \
#        -H 'Content-Type: application/json' -d '{"slug":"orbit","name":"Orbit"}'
QLIX_PARTNER_KEY=
# whsec_… from Qlix: verifies webhooks at POST /qlix/webhook (Qlix calls http://portfolio:4001/qlix/webhook).
QLIX_WEBHOOK_SECRET=
# 32+ random characters; encrypts the Qlix keys Orbit stores. Never change it after setup.
QLIX_SECRETS_KEY=
# Qlix console in the browser (local: http://localhost:3010). Also allowed to frame Orbit.
QLIX_CONSOLE_URL=http://localhost:3010
# Migration only: 1 = workspaces not yet provisioned use the shared QLIX_AGENT_ID below.
QLIX_LEGACY_AGENT_FALLBACK=0
QLIX_AGENT_ID=
QLIX_RUNNER_TOKEN=

# Optional fixed connector UUID (otherwise generated once into the wa_auth volume)
WA_CONNECTOR_ID=

# 64 hex chars — keep stable across restarts so WhatsApp session persists
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_AUTH_ENCRYPTION_KEY=

# Set to 0 after first boot if you do not want re-seed attempts
SEED_ON_START=1

# Meetings (LiveKit in the `meetings` container; docs/MEETINGS.md)
LIVEKIT_API_KEY=orbit
# 32+ random characters: openssl rand -hex 32
LIVEKIT_API_SECRET=
# What browsers connect to. Local Docker: ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Local Docker only: advertise 127.0.0.1 for media instead of the public IP
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_USE_EXTERNAL_IP=false
# Meeting Assistant speech-to-text: Qlix's whisper.cpp whisper-server, reachable from Docker
# (start it with --host 0.0.0.0, or run it on the exora network and use its service name).
QLIX_STT_URL=http://host.docker.internal:8178
QLIX_STT_LANGUAGE=en
