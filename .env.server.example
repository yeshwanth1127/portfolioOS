# PortfolioOS server .env — copy to .env and fill every value. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

JWT_SECRET=
AGENT_RUNNER_SECRET=
WA_SERVICE_SECRET=
# One password for all seeded demo logins (owner@portfolio.local, …)
DEMO_PASSWORD=

# Web port on 127.0.0.1 (nginx proxies the domain to it)
WEB_PORT=3101

# Qlix backend-adk (qlix-monorepo docker compose). Fill after scripts/create-qlix-agent.sh
QLIX_BACKEND_URL=http://backend:4000
QLIX_NETWORK=qlix-monorepo_default
QLIX_AGENT_ID=
QLIX_RUNNER_TOKEN=

# WhatsApp: any fixed UUID v4 (uuidgen) and a fixed 64-hex key so the link survives restarts
WA_CONNECTOR_ID=
WHATSAPP_AUTH_ENCRYPTION_KEY=

SEED_ON_START=1
