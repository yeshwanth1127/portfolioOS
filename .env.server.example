# PortfolioOS server .env — copy to .env and fill every value. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

JWT_SECRET=
AGENT_RUNNER_SECRET=
WA_SERVICE_SECRET=

# Database roles (docs/BUILD.md § 4.12) — generate with: openssl rand -hex 16
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
# One password for all seeded demo logins (owner@portfolio.local, …)
DEMO_PASSWORD=

# Public web port (put Nginx/Caddy with HTTPS in front of it)
WEB_PORT=3001

# Qlix backend-adk (qlix-monorepo docker compose). Fill after scripts/create-qlix-agent.sh
QLIX_BACKEND_URL=http://backend:4000
QLIX_NETWORK=qlix-monorepo_default
# Per-workspace Qlix: each workspace gets its own Qlix org with an "Assistant" and a
# "Report writer" agent (docs/QLIX_WORKSPACES.md). Get the partner key once from Qlix:
#   curl -X POST $QLIX_BACKEND_URL/api/v1/partners/register -H "x-admin-key: <PARTNER_REGISTRATION_KEY>" \
#        -H 'Content-Type: application/json' -d '{"slug":"orbit","name":"Orbit"}'
QLIX_PARTNER_KEY=
# whsec_… from Qlix: verifies webhooks at POST /qlix/webhook (Qlix calls http://portfolio:4001/qlix/webhook).
QLIX_WEBHOOK_SECRET=
# 32+ random characters; encrypts the Qlix keys Orbit stores. Never change it after setup.
QLIX_SECRETS_KEY=
# Qlix console in the browser (local: http://localhost:3010). Also allowed to frame Orbit.
QLIX_CONSOLE_URL=http://localhost:3010
# Migration only: 1 = workspaces not yet provisioned use the shared QLIX_AGENT_ID below.
QLIX_LEGACY_AGENT_FALLBACK=0
QLIX_AGENT_ID=
QLIX_RUNNER_TOKEN=

# WhatsApp: any fixed UUID v4 (uuidgen) and a fixed 64-hex key so the link survives restarts
WA_CONNECTOR_ID=
WHATSAPP_AUTH_ENCRYPTION_KEY=

SEED_ON_START=1

# Meetings (LiveKit; docs/MEETINGS.md). server-setup.sh fills these in.
LIVEKIT_API_KEY=orbit
LIVEKIT_API_SECRET=
# nginx proxies wss://<domain>/lk to the meetings container
LIVEKIT_PUBLIC_URL=
# Meeting Assistant speech-to-text: Qlix's whisper-server, reachable from the meetings container
QLIX_STT_URL=
QLIX_STT_LANGUAGE=en
